# nginx-cloudrun.conf.template v1.0.4 — proxy /csat para o backend (pagina publica de CSAT)
# VERSION: v1.0.4 | DATE: 2026-08-24 | AUTHOR: VeloHub Development Team

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Default do nginx é 1MB — bloqueava silenciosamente qualquer upload maior (ex.: planilha
    # Hugme do Reclame Aqui) com 413 antes mesmo da requisição chegar no Node. O multer da rota
    # de import já limita em 50MB; aqui só precisa não ser mais restritivo que isso.
    client_max_body_size 60m;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    location /velohub-api/ {
        proxy_pass ${VELOHUB_API_URL}/api/;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host ${VELOHUB_API_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/inbound/gmail/pubsub {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Cross-Origin-Opener-Policy;
        proxy_hide_header Cross-Origin-Embedder-Policy;
    }

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Cross-Origin-Opener-Policy;
        proxy_hide_header Cross-Origin-Embedder-Policy;
    }

    location /health {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_hide_header Cross-Origin-Opener-Policy;
        proxy_hide_header Cross-Origin-Embedder-Policy;
    }

    # Página pública de avaliação CSAT (link clicado no e-mail) — sem prefixo
    # /api, então precisa de location própria ou cai no fallback do SPA (/login).
    location /csat {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_hide_header Cross-Origin-Opener-Policy;
        proxy_hide_header Cross-Origin-Embedder-Policy;
    }

    # Página pública de decisão de workflow (botões Aprovar/Reprovar do e-mail).
    location /workflow-decisao {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_hide_header Cross-Origin-Opener-Policy;
        proxy_hide_header Cross-Origin-Embedder-Policy;
    }

    location / {
        add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
        try_files $uri $uri/ /index.html;
    }
}
