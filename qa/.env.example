# Agente de QA do Velodesk — contrato de variáveis
# VERSION: v1.0.0 | DATE: 2026-09-08
#
# Copie para qa/.env e preencha. NUNCA comite o .env.
# No GitHub Actions, cada linha vira um Secret com o mesmo nome.

# ── Ambiente ────────────────────────────────────────────────────────────────
# Origem do Velodesk (frontend e /api no mesmo host)
QA_BASE_URL=https://
# Só preencha se a API estiver em outro host
QA_API_URL=

# ── Lista de e-mails seguros (OBRIGATÓRIA) ──────────────────────────────────
# Únicos endereços que o QA pode usar. Sem isso o agente não roda.
# Separe por vírgula. Nunca inclua e-mail de cliente.
QA_EMAIL_ALLOWLIST=qa.velodesk@velotax.com.br

# ── Usuário de QA ───────────────────────────────────────────────────────────
# Colaborador com acesso ao Desk marcado no cadastro
QA_LOGIN_EMAIL=
QA_LOGIN_PASSWORD=
# Nome usado como responsável ao finalizar os tickets de teste
# (por padrão usa o nome que vier do próprio login)
QA_RESPONSAVEL=

# ── Criação dos tickets de teste ────────────────────────────────────────────
# Secret da origem dedicada "qa-teste" (35 caracteres a-z0-9) — não a do app.
# Ver docs/api-inbound-tickets-qa-teste.md. Precisa estar configurada também
# no servidor (INBOUND_TICKET_QA_TESTE_SECRET) para funcionar em produção.
QA_INBOUND_QA_TESTE_SECRET=
# CPF fictício dos tickets de teste — 11 dígitos.
# NÃO use 12345678901, 11122233300 nem 901000000xx: o backend apaga esses
# tickets em todo boot.
QA_CLIENT_CPF=

# ── Banco de dados (checagens por dados) ────────────────────────────────────
MONGODB_URI=
MONGODB_DB_NAME=b2c_chamados
MONGODB_CADASTROS_DB_NAME=b2c_cadastros
MONGODB_DESK_CONFIG_DB_NAME=desk_config

# ── Devolutiva sugerida por IA ──────────────────────────────────────────────
# A coluna "Devolutiva" da planilha é preenchida com uma orientação curta de
# correção. Com chave configurada, quem escreve é a IA; sem chave, entra a
# orientação base do catálogo (src/orientacoes.ts). A coluna nunca fica vazia.
# Use a mesma chave que o backend já usa.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Alternativa, quando não houver OpenAI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Sobrepõe o modelo, seja OpenAI ou Gemini
QA_IA_MODELO=
# true = não chama IA, usa só a orientação base do catálogo
QA_IA_DESATIVADA=false

# ── Comportamento ───────────────────────────────────────────────────────────
# true = não cria nada, não envia e-mail, só lê
QA_SOMENTE_LEITURA=false
# true = pula a camada de navegador (Playwright)
QA_PULAR_UI=false
# Rótulo da rodada na planilha (vazio = calcula pelo horário)
QA_RODADA=
# Caminho da planilha consolidada (vazio = qa/relatorios/Consolidado_QA_Velodesk.xlsx)
QA_PLANILHA=
# false = a execução não falha quando um teste falha
QA_FALHAR_NA_FALHA=true
