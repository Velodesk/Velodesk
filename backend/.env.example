# Contrato de variáveis — credenciais compartilhadas em FONTE DA VERDADE/.env-velodesk
# VERSION: v1.2.1 | DATE: 2026-08-12
# backend/.env está no .gitignore — overrides locais (JWT, Mongo, etc.)
# GOOGLE_CLIENT_ID / VITE_GOOGLE_CLIENT_ID: definir em FONTE DA VERDADE/.env-velodesk

PORT=8001
NODE_ENV=development
VELODESK=8000
VELODESK_BACKEND=8001

MONGODB_URI=
MONGODB_DB_NAME=b2c_chamados
MONGODB_CADASTROS_DB_NAME=b2c_cadastros
MONGODB_DESK_CONFIG_DB_NAME=desk_config
MONGODB_DESK_PREFERENCES_DB_NAME=desk_preferences

# VeloHubCentral — cadastro colaboradores Desk (GET /api/colaboradores)
# Definir em FONTE DA VERDADE/.env como MONGO_ENV (secret Cloud Run: MONGO_ENV)
# MONGO_ENV=
# MONGODB_FUNCIONARIOS_DB_NAME=console_funcionarios
# MONGODB_FUNCIONARIOS_COLLECTION=funcionarios_cadastroColaboradores

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth (login Desk fase testes)
GOOGLE_CLIENT_ID=

# WhatsApp — Twilio (preencher no .env-velodesk)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SUBACCOUNT_SID=
# TWILIO_SUBACCOUNT_AUTH_TOKEN=
# TWILIO_API_KEY_SID=SK...
# TWILIO_API_KEY_SECRET=
# TWILIO_WHATSAPP_FROM=whatsapp:+17406697857
# TWILIO_WHATSAPP_WEBHOOK_URL=https://velodesk-278491073220.us-east1.run.app/api/inbound/whatsapp/messages
# TWILIO_WHATSAPP_STATUS_CALLBACK_URL=https://velodesk-278491073220.us-east1.run.app/api/inbound/whatsapp/message-status
# TWILIO_WHATSAPP_PROFILE_NAME=Velotax
# TWILIO_WHATSAPP_CONTENT_SID=HXb5b62575e6e4ff6129ad7c8efe1f983e
# Template UTILITY — mensagem ativa Desk (1º contato / fora da janela 24h)
# TWILIO_WHATSAPP_DESK_ACTIVE_CONTENT_SID=HXcbba12297392a996aeaf60af3e05ccc4
WHATSAPP_INBOUND_ENABLED=true
# Sync diário 03:00 BRT: Twilio Messages API → coleção b2c_chamados.whatsapp_message_costs (WFM consome)
WHATSAPP_COST_SYNC_ENABLED=true
# Produção: deixe vazio — inbound só registra no ticket; resposta vem do agente no Desk
# TWILIO_WHATSAPP_AUTO_REPLY=
# TWILIO_WEBHOOK_SKIP_VALIDATION=true
# Base pública para validar X-Twilio-Signature (deve ser a URL do sender na Twilio)
# TWILIO_WEBHOOK_PUBLIC_BASE_URL=https://velodesk-278491073220.us-east1.run.app
# Webhook produção: https://velodesk-278491073220.us-east1.run.app/api/inbound/whatsapp/messages

# Gmail Workspace — desk_config.email_transport (seed: npm run seed:email-transport)
EMAIL_ENABLED=false
DESK_EMAIL_TRANSPORT_COLLECTION=email_transport
DESK_EMAIL_TRANSPORT_DOCUMENT_ID=desk_email_transport

# Gmail inbound via Pub/Sub (produção)
GMAIL_INBOUND_ENABLED=false
GCP_PROJECT_ID=velohub-471220
GMAIL_PUBSUB_TOPIC=gmail-desk-inbound
GMAIL_PUBSUB_VERIFY_TOKEN=
GMAIL_WATCH_STATE_COLLECTION=gmail_watch_state
GMAIL_WATCH_STATE_DOCUMENT_ID=desk_gmail_watch
GMAIL_INBOUND_MAX_MESSAGES_PER_PUSH=8
GMAIL_INBOUND_BUDGET_MS=50000

# Anexos — bucket velodesk_storage (prevenção de acesso público OK; download via API autenticada)
# INBOUND_ATTACHMENTS_DIR=./data/inbound-attachments
# SENT_ATTACHMENTS_DIR=./data/sent-attachments
GCP_STORAGE_BUCKET=velodesk_storage
GCP_EMAIL_RESOURCES_BUCKET=velodesk_resources
GCP_EMAIL_SIGNATURE_PREFIX=mail_signature_img
GCP_STORAGE_INBOUND_ATTACHMENTS_PREFIX=desk_ticket_attachments
GCP_STORAGE_INBOUND_QUARANTINE_PREFIX=desk_ticket_attachments_quarantine
GCP_STORAGE_SENT_ATTACHMENTS_PREFIX=desk_ticket_sent_attachments
GCP_STORAGE_OCTADESK_LEGACY_PREFIX=octadesk_legacy_attachments
ATTACHMENT_SCAN_CALLBACK_SECRET=
# legado (inbound): GCP_STORAGE_ATTACHMENTS_PREFIX=desk_ticket_attachments

# Dump Octadesk → legado_tickets.importados_octadesk (scripts offline; nunca commitar a key)
# OCTADESK_API_BASE=https://o199103-bfa.api001.octadesk.services
# OCTADESK_API_KEY=
# OCTADESK_AGENT_EMAIL=
# MONGODB_LEGADO_TICKETS_DB_NAME=legado_tickets

# Inbound e-mail webhook (dev / fallback Mailgun)
INBOUND_EMAIL_ENABLED=false
INBOUND_EMAIL_PROVIDER=generic
INBOUND_EMAIL_WEBHOOK_SECRET=
INBOUND_EMAIL_ALLOWED_RECIPIENTS=

# Inbound e-mail — casos especiais (destino + padrões de remetente)
# INBOUND_EMAIL_PROCON_RECIPIENTS=
# INBOUND_EMAIL_PROCON_SENDER_PATTERNS=
# INBOUND_EMAIL_CONSUMIDOR_GOV_RECIPIENTS=
# INBOUND_EMAIL_CONSUMIDOR_GOV_SENDER_PATTERNS=
# INBOUND_EMAIL_BACEN_RECIPIENTS=
# INBOUND_EMAIL_BACEN_SENDER_PATTERNS=

# Outbound e-mail (Fase 1b)
EMAIL_FROM=
EMAIL_API_KEY=

# LanguageTool open source (self-hosted) — corretor gramatical do compose
# Local sem Docker: docker run --rm -p 8010:8010 erikvl87/languagetool
LANGUAGETOOL_ENABLED=true
LANGUAGETOOL_URL=http://localhost:8010
LANGUAGETOOL_LANGUAGE=pt-BR
LANGUAGETOOL_TIMEOUT_MS=8000

# Gemini — refinar rascunho (Assistente IA no compose)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REFINAR_MODEL=gemini-2.5-flash-lite

# OpenAI — sugestão IA de resposta e tabulação na abertura do ticket (vector store POPs)
OPENAI_API_KEY=

# Consulta Operacional (barra Processos no Desk) — pastas com .docx (resumo) e .pdf (completo)
# Default no container: /app/api/source file/POPs e .../POP Completo (copiadas no Dockerfile)
# POPS_SOURCE_DIR=
# POPS_COMPLETO_SOURCE_DIR=
# Áudios recebidos por WhatsApp: player sempre disponível; transcrição sob demanda usa OpenAI.
WHATSAPP_AUDIO_TRANSCRIPTION_ENABLED=true
WHATSAPP_AUDIO_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_VECTOR_STORE_ID=
OPENAI_POP_VECTOR_STORE_ID=
OPENAI_PUBLIC_VECTOR_STORE_ID=
OPENAI_AUDIT_VECTOR_STORE_ID=
# Alias aceito pelo backend: VECTOR_STORE_PATH (mesmo valor vs_...)
OPENAI_MODEL=gpt-4.1-mini

# Agentes paralelos — Atendimento (1), Auditoria (2), Gestão (3), Casos Especiais (4)
AGENTS_ENABLED=false
AGENTS_AUTONOMY_ENABLED=false
# Agente 4: sem lista de e-mail de alerta — quem tem a função do órgão (Bacen/Procon/Consumidor.gov/
# Reclame Aqui) já vê o item no dash dedicado e recebe notificação no sininho (workflow_notificacoes).
AGENT_CASOS_ESPECIAIS_ENABLED=false
# Agente 5: extrai os campos do esquema (Procon/Bacen/Consumidor.gov) a partir do corpo do e-mail,
# só depois que o Agente 4 já classificou o ticket como caso formal daquele órgão.
AGENT_CASOS_ESPECIAIS_EXTRACAO_ENABLED=false
# Agente 6: correlaciona a reclamação (Reclame Aqui) com o histórico de tickets do CPF do cliente.
AGENT_CASOS_ESPECIAIS_RELACIONADOS_ENABLED=false
AGENT_AUDIT_THRESHOLD_AUTO=85
AGENT_AUDIT_THRESHOLD_DESK=70
AGENT_REVISION_MAX_ATTEMPTS=2
GESTAO_CHAMADOS_INTERVAL_MS=300000
GESTAO_SPIKE_THRESHOLD=10
GESTAO_SPIKE_WINDOW_MIN=30
GESTAO_STUCK_NOVO_MINUTES=120
GESTAO_STUCK_ACTIVE_HOURS=4
GESTAO_ALERT_EMAILS=

# Roleta de atribuição — chamados sem responsavel (e-mail inbound, app integrado)
ASSIGNMENT_ROUTER_ENABLED=true
ASSIGNMENT_ROUTER_STRATEGY=least_loaded
ASSIGNMENT_ROUTER_TERMINAL_STATUSES=resolvido,cancelado,fechado

# Fecha tickets Resolvido → Fechado após 48h (job horário; 1ª run faz backfill)
RESOLVED_CLOSE_INTERVAL_MS=3600000
RESOLVED_CLOSE_AFTER_MS=172800000
# Pendente → Resolvido após 48h (job a cada hora cheia)
PENDENTE_RESOLVE_AFTER_MS=172800000

# App integrado — notificação pós-insert em chamados_n1 (header x-inbound-secret)
# Inbound app (notificação pós-insert)
INBOUND_APP_WEBHOOK_SECRET=

# Abertura de ticket inbound — POST /api/inbound/tickets
# Chaves: exatamente 35 caracteres [a-z0-9] — gerar com npm run generate:inbound-ticket-secrets
INBOUND_TICKETS_ENABLED=true
INBOUND_TICKET_APP_SECRET=
INBOUND_TICKET_TELEFONE_SECRET=
INBOUND_TICKET_AGENTE_IA_SECRET=
INBOUND_TICKET_CHAT_SECRET=
INBOUND_TICKET_QA_TESTE_SECRET=

# Inbound telefonia IA (empresa parceira)
INBOUND_TELEPHONY_ENABLED=true
INBOUND_TELEPHONY_WEBHOOK_SECRET=
TELEPHONY_AUTO_CREATE_TICKET=false

# Sequência do chamadoProtocolo — valor numérico base (100177678 → exibido como 0100177678)
# Abaixo de 1.000.000.000: prefixo 0 + 9 dígitos (… até 0999999999); depois 1000000000+
TICKET_SEQUENCE_FLOOR=100177678

# Aba Consultas — Velotax Customer Data API (definir na FONTE DA VERDADE/.env-velodesk)
# x-api-key=
# Alternativas aceitas pelo backend: CUSTOMER_DATA_API_KEY, VELOTAX_CUSTOMER_DATA_API_KEY
VELOTAX_CUSTOMER_DATA_BASE_URL=https://customer-data.velotax.com.br
VELOTAX_CUSTOMER_DATA_TIMEOUT_MS=30000

# Realtime / 55PBX — telefonia via Supabase WFM (aba Gestão /realtime)
REALTIME_ENABLED=true
REALTIME_SUPABASE_URL=
REALTIME_SUPABASE_SERVICE_ROLE_KEY=
TELECOM55_WEBHOOK_SECRET=

# Presence de ticket (indicador de agente vendo/com aba aberta) — Supabase Realtime
# JWT Secret do projeto Supabase usado (Settings → API → JWT Settings → JWT Secret legado)
# Backend assina um JWT próprio com esse segredo; Supabase Realtime autoriza o canal privado.
PRESENCE_REALTIME_JWT_SECRET=
PRESENCE_REALTIME_TOKEN_TTL_SEC=600

